---
import Socials from "./Socials.astro";
import { getLocations } from "../lib/content";
import { phoneHref, site } from "../lib/site";
// Footer ported from the original site. NAP comes from data/site.json (identical to the Google listing); the service-area
// list is generated from content/locations in the same order as the rest of the site (SITE_RULES 5.13).
const { name, phone, email, address } = site.business;
const locations = await getLocations();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-logo"><img src="/images/brand/logo-white.png" alt={name} width="316" height="190"></p>
        <p class="footer-tagline">Beautiful spaces. Inspired by you. Interior design and renovation across Southwest Florida.</p>
        <p class="footer-address">{name}<br>{address.street}<br>{address.city}, {address.region} {address.postalCode}<br><a href={phoneHref(phone)}>{phone}</a><br><a href={`mailto:${email}`}>{email}</a></p>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/services/interior-design">Interior Design</a></li>
          <li><a href="/services/space-planning">Space Planning</a></li>
          <li><a href="/services/color-consultation">Color Consultation</a></li>
          <li><a href="/services/kitchen-bath-design">Kitchen &amp; Bath Design</a></li>
          <li><a href="/services/new-construction-design">New Construction Design</a></li>
        </ul>
      </div>
      <div>
        <h4>Design Details</h4>
        <ul>
          <li><a href="/services/custom-fabrics">Custom Fabrics</a></li>
          <li><a href="/services/upholstery-bedding">Upholstery &amp; Bedding</a></li>
          <li><a href="/services/furniture-selection">Indoor &amp; Outdoor Furniture</a></li>
          <li><a href="/services/window-treatments">Window Treatments</a></li>
          <li><a href="/services/lighting-selection">Lighting &amp; Accessories</a></li>
          <li><a href="/services/wallcoverings">Wall Designs: Paper &amp; Textures</a></li>
          <li><a href="/services/rugs-fabrics">Rugs &amp; Floor Coverings</a></li>
          <li><a href="/services/art-accessories">Art &amp; Styling</a></li>
        </ul>
      </div>
      <div>
        <h4>Service Area</h4>
        <ul>
          {locations.map((l) => <li><a href={`/locations/${l.id}`}>{l.data.name}</a></li>)}
          <li><a href="/locations">All service areas</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/team">Meet the Team</a></li>
          <li><a href="/portfolio">Portfolio</a></li>
          <li><a href="/partners">Our Partners</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
    <Socials />
    <div class="footer-bottom">
      <p>© 2026 {name}. All rights reserved. <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
      <p>Serving Sarasota, Charlotte &amp; Lee Counties, FL</p>
    </div>
  </div>
</footer>
