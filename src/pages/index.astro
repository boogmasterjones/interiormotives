---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getHome } from '../lib/content';
import { faqSchema } from '../lib/schema';

const page = await getHome();
const { Content } = await render(page);
// The business node itself is added to every page by Base.
const jsonLd = page.data.faqs.length > 0 ? [faqSchema(page.data.faqs)] : [];
---

<Base title={page.data.title} description={page.data.description} image={page.data.image} jsonLd={jsonLd} bodyClass={page.data.bodyClass}>
  <Content />
</Base>
